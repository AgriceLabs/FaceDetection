{
  "name": "viola-jones-livestream-cli",
  "version": "1.0.0",
  "description": "CLI tool for real-time face detection on YouTube livestreams using Viola-Jones algorithm",
  "type": "module",
  "bin": {
    "vj-detect": "./dist/index.js"
  },
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "viola-jones",
    "face-detection",
    "youtube",
    "livestream",
    "cli"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "ts-node": "^10.9.2"
  }
}
